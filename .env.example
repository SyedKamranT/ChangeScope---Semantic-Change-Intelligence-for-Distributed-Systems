# ChangeScope Local Development Environment Configuration Template
# Copy this file to .env and adjust credentials as required

# Environment Mode: local, test, staging, production
CHANGESCOPE_ENVIRONMENT=local
CHANGESCOPE_DEBUG=true
CHANGESCOPE_LOG_LEVEL=INFO

# Canonical Relational Database (PostgreSQL 17)
CHANGESCOPE_DATABASE_URL=postgresql+asyncpg://changescope:changescope_password@localhost:5432/changescope
CHANGESCOPE_DB_POOL_SIZE=20
CHANGESCOPE_DB_MAX_OVERFLOW=10

# Redis Cache & Background Tasks
CHANGESCOPE_REDIS_URL=redis://localhost:6379/0

# Neo4j Graph Projection Database
CHANGESCOPE_NEO4J_URI=bolt://localhost:7687
CHANGESCOPE_NEO4J_USER=neo4j
CHANGESCOPE_NEO4J_PASSWORD=changescope_password
CHANGESCOPE_NEO4J_MOCK_MODE=false

# Security & Cryptographic Token Configuration
# Minimum 32 characters for HMAC secret
CHANGESCOPE_JWT_SECRET=changescope_dev_secret_key_at_least_32_bytes_long_1234
CHANGESCOPE_JWT_ALGORITHM=HS256
CHANGESCOPE_JWT_EXPIRE_MINUTES=1440

# External OIDC Provider (Optional)
# CHANGESCOPE_OIDC_ISSUER_URL=https://auth.example.com
# CHANGESCOPE_OIDC_AUDIENCE=changescope-api

# GitHub Integration
CHANGESCOPE_GITHUB_WEBHOOK_SECRET=changescope_webhook_secret_dev
