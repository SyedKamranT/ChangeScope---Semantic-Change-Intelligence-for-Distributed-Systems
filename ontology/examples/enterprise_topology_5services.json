    {
      "urn": "urn:cseo:concept:CustomerIdentifier",
      "name": "Customer Identifier",
      "category": "Identifier",
      "bounded_context": "global",
      "description": "Universal unique identifier representing an authenticated buyer or tenant customer across all platform services.",
      "synonyms": [
        "customer_id",
        "account_holder_uuid",
        "user_id",
        "recipient_id",
        "buyer_uuid"
      ],
      "homonym_distinctions": {},
      "constraints": {
        "format": "uuid-v4",
        "immutable": true
      }
    },
    {
      "urn": "urn:cseo:concept:MonetaryValue",
      "name": "Monetary Value (Minor Units)",
      "category": "MonetaryValue",
      "bounded_context": "financial",
      "description": "Exact integer monetary quantity represented in currency minor units (e.g. cents) to eliminate floating-point drift.",
      "synonyms": [
        "amount_cents",
        "charge_cents",
        "total_price_cents",
        "balance_minor_units"
      ],
      "homonym_distinctions": {},
      "constraints": {
        "type": "integer",
        "min": 0,
        "currency_standard": "ISO-4217"
      }
    },
    {
      "urn": "urn:cseo:concept:auth:Account",
      "name": "Identity Authentication Account",
      "category": "Account",
      "bounded_context": "auth",
      "description": "Authentication credential, role assignment, and security login profile managed by auth-service.",
      "synonyms": [
        "user_account",
        "login_principal",
        "auth_profile"
      ],
      "homonym_distinctions": {
        "billing": "Financial ledger account storing cash balances and payment instruments."
      },
      "constraints": {
        "mfa_enforceable": true
      }
    },
    {
      "urn": "urn:cseo:concept:billing:Account",
      "name": "General Ledger Settlement Account",
      "category": "Account",
      "bounded_context": "billing",
      "description": "Double-entry bookkeeping ledger account in payment-service tracking receivables, payables, and transactions.",
      "synonyms": [
        "ledger_account",
        "merchant_account",
        "settlement_wallet"
      ],
      "homonym_distinctions": {
        "auth": "Security identity login account with credentials and JWT grants."
      },
      "constraints": {
        "currency_locked": true
      }
    },
    {
      "urn": "urn:cseo:concept:OrderStatus",
      "name": "Order Lifecycle State",
      "category": "Status",
      "bounded_context": "order",
      "description": "Discrete state of a customer order in order-service.",
      "synonyms": [
        "order_state",
        "fulfillment_status"
      ],
      "homonym_distinctions": {
        "inventory": "Warehouse stock allocation state."
      },
      "constraints": {
        "allowed_values": ["PENDING", "CONFIRMED", "PROCESSING", "SHIPPED", "CANCELLED"]
      }
    }
